# Never commit secrets. Keys and env files must stay out of the repo.
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

# Local config for the standalone verifier (holds a merchant's zpub + read-only token).
verifier_config.json

# Logs (runtime logs can contain sensitive data, never commit them).
*.log

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
